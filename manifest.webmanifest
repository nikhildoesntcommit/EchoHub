{
  "name": "EchoHub — Tune into ideas",
  "short_name": "EchoHub",
  "description": "A radio for curious minds. Drag the dial to tune into short audio explainers on technology, science, geography and history.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0c10",
  "theme_color": "#0d0c10",
  "categories": ["education", "entertainment", "music"],
  "lang": "en",
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Studio", "short_name": "Studio", "description": "Generate a two-host episode on any topic", "url": "./#/studio", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "short_name": "Library", "description": "Your kept stations, history and downloads", "url": "./#/library", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "assets/img/screenshot-wide.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "The EchoHub dial" },
    { "src": "assets/img/screenshot-mobile.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Now playing" }
  ]
}
